{
  "version": "1.3.0",
  "slug": "progress",
  "section": "components",
  "parts": [
    {
      "directive": "RdxProgressIndicatorDirective",
      "selector": "[rdxProgressIndicator]",
      "exportAs": "rdxProgressIndicator",
      "description": "Displays the visual progress fill.",
      "inputs": [],
      "outputs": []
    },
    {
      "directive": "RdxProgressLabelDirective",
      "selector": "[rdxProgressLabel]",
      "exportAs": "rdxProgressLabel",
      "description": "Labels the progress task.",
      "inputs": [
        {
          "name": "id",
          "type": "string",
          "description": "ID of this label. Defaults to the Root's label ID."
        }
      ],
      "outputs": []
    },
    {
      "directive": "RdxProgressRootDirective",
      "selector": "[rdxProgressRoot]",
      "exportAs": "rdxProgressRoot",
      "description": "Provides progress state and accessibility attributes.",
      "inputs": [
        {
          "name": "aria-labelledby",
          "type": "string | null",
          "default": "undefined",
          "description": "Explicit IDs of the elements that provide the accessible name."
        },
        {
          "name": "aria-valuetext",
          "type": "string | null",
          "default": "undefined",
          "description": "Explicit accessible value text."
        },
        {
          "name": "format",
          "type": "Intl.NumberFormatOptions",
          "description": "Number format for the clamped value. The default formats the percentage of the range."
        },
        {
          "name": "getAriaValueText",
          "type": "ProgressAriaValueFormatter",
          "description": "Formats accessible value text using the visible text and the original supplied value."
        },
        {
          "name": "labelId",
          "default": "injectId('rdx-progress-label-')"
        },
        {
          "name": "locale",
          "type": "Intl.LocalesArgument",
          "description": "Locale used by the number formatter."
        },
        {
          "name": "max",
          "default": "DEFAULT_MAX",
          "description": "Maximum progress value."
        },
        {
          "name": "min",
          "default": "DEFAULT_MIN",
          "description": "Minimum progress value."
        },
        {
          "name": "value",
          "type": "number | null",
          "default": "null",
          "description": "Current progress value. Null and non-finite values indicate indeterminate progress."
        },
        {
          "name": "valueId",
          "default": "injectId('rdx-progress-value-')"
        },
        {
          "name": "valueLabel",
          "type": "ProgressValueFormatter",
          "default": "this.defaultValueLabel",
          "description": "Formats the clamped value for `rdxProgressValue` and the default accessible value text."
        }
      ],
      "outputs": []
    },
    {
      "directive": "RdxProgressTrackDirective",
      "selector": "[rdxProgressTrack]",
      "exportAs": "rdxProgressTrack",
      "description": "Contains the visual progress indicator.",
      "inputs": [],
      "outputs": []
    },
    {
      "directive": "RdxProgressValueDirective",
      "selector": "[rdxProgressValue]",
      "exportAs": "rdxProgressValue",
      "description": "Displays the formatted progress value.",
      "inputs": [],
      "outputs": []
    }
  ]
}
