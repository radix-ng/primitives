{
  "version": "1.3.0",
  "name": "Alert Dialog",
  "slug": "alert-dialog",
  "section": "components",
  "description": "A modal dialog that interrupts the user with important content and expects a response.",
  "doc": "radix-ng-examples/references/components/alert-dialog.md",
  "storybook": "https://radix-ng.com/docs/?path=/docs/primitives-alert-dialog--docs",
  "anatomy": "<div rdxAlertDialogRoot>\n  <button rdxAlertDialogTrigger>Delete</button>\n\n  <ng-template rdxAlertDialogPortal>\n    <div rdxAlertDialogBackdrop></div>\n    <div rdxAlertDialogPopup>\n      <h2 rdxAlertDialogTitle>Are you sure?</h2>\n      <p rdxAlertDialogDescription>This action cannot be undone.</p>\n      <button rdxAlertDialogClose>Cancel</button>\n      <button rdxAlertDialogClose>Confirm</button>\n    </div>\n  </ng-template>\n</div>",
  "dataAttributes": [
    {
      "attribute": "data-popup-open",
      "parts": "Trigger",
      "values": "The alert dialog is open."
    },
    {
      "attribute": "data-open",
      "parts": "Popup, Backdrop, Viewport",
      "values": "The alert dialog is open."
    },
    {
      "attribute": "data-closed",
      "parts": "Popup, Backdrop, Viewport",
      "values": "The alert dialog is closed."
    },
    {
      "attribute": "data-starting-style",
      "parts": "Popup, Backdrop, Viewport",
      "values": "The enter transition is starting."
    },
    {
      "attribute": "data-ending-style",
      "parts": "Popup, Backdrop, Viewport",
      "values": "The exit transition is running."
    },
    {
      "attribute": "data-nested",
      "parts": "Popup, Backdrop, Viewport",
      "values": "The alert dialog is nested in another dialog."
    },
    {
      "attribute": "data-nested-dialog-open",
      "parts": "Popup, Backdrop, Viewport",
      "values": "A descendant dialog is open."
    }
  ]
}
