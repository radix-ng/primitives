{
  "version": "1.3.0",
  "name": "Autocomplete",
  "slug": "autocomplete",
  "section": "components",
  "description": "A text input with a list of suggestions: free-form text whose value **is** the input string, with the active option tracked via `aria-activedescendant`.",
  "doc": "radix-ng-examples/references/components/autocomplete.md",
  "storybook": "https://radix-ng.com/docs/?path=/docs/primitives-autocomplete--docs",
  "anatomy": "<div rdxAutocompleteRoot>\n  <div rdxAutocompleteInputGroup>\n    <input rdxAutocompleteInput />\n    <button rdxAutocompleteClear></button>\n  </div>\n\n  <div *rdxAutocompletePortal rdxAutocompletePositioner>\n    <div rdxAutocompletePopup>\n      <div rdxAutocompleteList>\n        <div rdxAutocompleteGroup>\n          <div rdxAutocompleteGroupLabel></div>\n          <div rdxAutocompleteItem>\n            <span rdxAutocompleteItemIndicator></span>\n          </div>\n        </div>\n      </div>\n      <div rdxAutocompleteEmpty></div>\n    </div>\n  </div>\n</div>",
  "dataAttributes": [
    {
      "attribute": "data-popup-open",
      "parts": "RdxAutocompleteInput",
      "values": "The popup is open."
    },
    {
      "attribute": "data-list-empty",
      "parts": "RdxAutocompleteInput",
      "values": "No matching suggestions are visible."
    },
    {
      "attribute": "data-filled",
      "parts": "RdxAutocompleteInput",
      "values": "The input contains a value."
    },
    {
      "attribute": "data-disabled",
      "parts": "RdxAutocompleteInput",
      "values": "The input is disabled."
    },
    {
      "attribute": "data-invalid",
      "parts": "RdxAutocompleteInput",
      "values": "Displayed validation is invalid."
    },
    {
      "attribute": "data-valid",
      "parts": "RdxAutocompleteInput",
      "values": "Displayed validation is valid."
    },
    {
      "attribute": "data-required",
      "parts": "RdxAutocompleteInput",
      "values": "The input is required."
    },
    {
      "attribute": "data-focused",
      "parts": "RdxAutocompleteInput",
      "values": "The input is focused."
    },
    {
      "attribute": "data-touched",
      "parts": "RdxAutocompleteInput",
      "values": "The input has been touched."
    },
    {
      "attribute": "data-dirty",
      "parts": "RdxAutocompleteInput",
      "values": "The input value has changed."
    },
    {
